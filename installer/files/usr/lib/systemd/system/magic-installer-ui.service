[Unit]
Description=Magic installer (screen)
After=systemd-user-sessions.service magic-installer-backend.service
Wants=magic-installer-backend.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=installer
PAMName=cage
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=MOZ_ENABLE_WAYLAND=1
Environment=XKB_DEFAULT_LAYOUT=gb
EnvironmentFile=-/run/magic-installer/xkb.env
ExecStartPre=/usr/bin/bash -c 'for i in $(seq 60); do curl -s -o /dev/null http://127.0.0.1:8080/ && exit 0; sleep 0.5; done; exit 0'
# "+": run as root (plymouth must let go of the screen before cage can take it).
ExecStartPre=+-/usr/bin/plymouth quit --retain-splash
ExecStart=/usr/bin/cage -s -d -- /usr/bin/firefox --kiosk http://127.0.0.1:8080/
Restart=always
RestartSec=1

[Install]
WantedBy=graphical.target
