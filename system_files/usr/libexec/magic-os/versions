#!/usr/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Prints Magic's versions as JSON: what is running, what is waiting for the
# next restart, the one you could go back to, and (with --online) the newest
# release. Versions come from each system's own os-release, because the image
# metadata does not keep a version label.
set -uo pipefail
REPO="ghcr.io/alex-ha-192/magic-os"
status=$(rpm-ostree status --json 2>/dev/null || echo '{"deployments":[]}')
ver_of() {   # checksum serial osname -> VERSION from that deployment's os-release
    local f="/ostree/deploy/$3/deploy/$1.$2/usr/lib/os-release"
    [[ -r "$f" ]] && sed -n 's/^VERSION="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$f"
}
running=$(. /usr/lib/os-release; echo "${VERSION:-}")
waiting=""; previous=""; seen_booted=0
while read -r c n o b _; do
    [[ -z "$c" ]] && continue
    v=$(ver_of "$c" "$n" "$o")
    if [[ "$b" == "true" ]]; then seen_booted=1
    elif [[ $seen_booted == 0 ]]; then waiting=$v      # listed before the running one: used next restart
    elif [[ -z "$previous" ]]; then previous=$v
    fi
done < <(jq -r '.deployments[] | "\(.checksum) \(.serial) \(.osname) \(.booted) \(.staged // false)"' <<<"$status")
newest=""
if [[ "${1:-}" == "--online" ]]; then
    want=$(skopeo inspect --no-tags --format '{{.Digest}}' "docker://${REPO}:latest" 2>/dev/null || true)
    if [[ -n "$want" ]]; then
        for t in $(skopeo list-tags "docker://${REPO}" 2>/dev/null | jq -r '.Tags[]' | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}(-[0-9]+)?$' | sort -rV | head -8); do
            d=$(skopeo inspect --no-tags --format '{{.Digest}}' "docker://${REPO}:${t}" 2>/dev/null || true)
            [[ "$d" == "$want" ]] && { newest=$t; break; }
        done
    fi
fi
jq -n --arg r "$running" --arg w "$waiting" --arg p "$previous" --arg n "$newest" \
    '{running: $r, waiting: $w, previous: $p, newest: $n}'
