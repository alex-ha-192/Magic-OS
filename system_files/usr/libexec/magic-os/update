#!/usr/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Daily: if a newer Magic is out, download it and get it ready for the next
# restart. Never restarts anything. Skips a version the person went back from.
set -uo pipefail
SKIP_FILE=/var/lib/magic-os/skip-version
v=$(/usr/libexec/magic-os/versions --online)
newest=$(jq -r .newest <<<"$v"); running=$(jq -r .running <<<"$v"); waiting=$(jq -r .waiting <<<"$v")
skip=$(cat "$SKIP_FILE" 2>/dev/null || true)
echo "newest=${newest:-unknown} running=$running waiting=${waiting:-none} skip=${skip:-none}"
if [[ -z "$newest" ]]; then
    echo "Could not reach the update server; will try again later."
    exit 0
fi
[[ "$newest" == "$running" || "$newest" == "$waiting" ]] && exit 0
if [[ -n "$skip" && "$newest" == "$skip" ]]; then
    echo "Skipping $newest: you went back from it. Waiting for a newer version."
    exit 0
fi
rm -f "$SKIP_FILE"
# Stages the new version; it is used on the next restart or shutdown.
rpm-ostree upgrade
