#!/usr/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Runs once, on the first start after installing, before the sign-in screen.
# Applies what the person chose in the installer, then deletes the setup file.
set -euo pipefail
S=/var/lib/magic-os/setup.json
[[ -f "$S" ]] || exit 0
TEST=$(jq -r '.test // false' "$S")

say() {
    echo "magic-firstboot: $*"; echo "magic-firstboot: $*" > /dev/kmsg 2>/dev/null || true
    # Automated tests read the serial port.
    [[ "${TEST:-false}" == "true" ]] && echo "magic-firstboot: $*" > /dev/ttyS0 2>/dev/null || true
}
j() { jq -r "$1 // empty" "$S"; }

# Files written by the installer have no SELinux labels yet.
restorecon -RF /var/lib/magic-os /var/lib/flatpak /var/home 2>/dev/null || true

user=$(j .user.username)
full=$(j .user.full_name)
hash=$(j .user.password_hash)
if [[ -n "$user" ]]; then
    id "$user" &>/dev/null || useradd -m -c "$full" -G wheel "$user"
    [[ -n "$hash" ]] && usermod -p "$hash" "$user"
fi

h=$(j .hostname); ph=$(j .pretty_hostname)
[[ -n "$h" ]] && hostnamectl set-hostname --static "$h" || true
[[ -n "$ph" ]] && hostnamectl set-hostname --pretty "$ph" || true

tz=$(j .timezone)
[[ -n "$tz" && -f "/usr/share/zoneinfo/$tz" ]] && timedatectl set-timezone "$tz" || true

loc=$(j .locale)
[[ -n "$loc" ]] && localectl set-locale "LANG=$loc" || true

kl=$(j .keyboard.layout); kv=$(j .keyboard.variant)
[[ -n "$kl" ]] && localectl set-x11-keymap "$kl" "" "$kv" || true

if [[ -n "$user" ]]; then
    home=$(getent passwd "$user" | cut -d: -f6)
    mkdir -p "$home/.config"
    # Accent: the full colour scheme for that accent, so every app uses it.
    acc=$(j .accent)
    name=$(jq -r --arg a "$acc" '.accents[$a].name // empty' /usr/share/magic-os/accents.json)
    [[ -n "$name" ]] || { acc=$(jq -r .default /usr/share/magic-os/accents.json); name=$(jq -r --arg a "$acc" '.accents[$a].name' /usr/share/magic-os/accents.json); }
    scheme="/usr/share/color-schemes/Magic${name}.colors"
    {
        printf '[General]\nColorScheme=Magic%s\nMagicAccent=%s\n\n' "$name" "$acc"
        # every [Colors:*], [ColorEffects:*] and [WM] group from the scheme
        awk '/^\[/{keep = ($0 ~ /^\[(Colors|ColorEffects|WM)/)} keep' "$scheme"
    } > "$home/.config/kdeglobals"
    wall="/usr/share/wallpapers/Magic${name}/contents/images/3840x2160.jpg"
    printf '[Greeter]\nWallpaperPlugin=org.kde.image\n\n[Greeter][Wallpaper][org.kde.image][General]\nImage=file://%s\n' "$wall" > "$home/.config/kscreenlockerrc"
    # Sign-in screen follows the accent of the person who installed Magic.
    mkdir -p /var/lib/magic-os
    cp -f "$wall" /var/lib/magic-os/signin.jpg
    chmod 0644 /var/lib/magic-os/signin.jpg
    /usr/libexec/magic-os/signin-wallpaper /var/lib/magic-os/signin.jpg
    # Keyboard layout for Plasma (it keeps its own setting per person).
    if [[ -n "$kl" ]]; then
        printf '[Layout]\nUse=true\nLayoutList=%s\nVariantList=%s\n' "$kl" "$kv" > "$home/.config/kxkbrc"
    fi
    # Language for Plasma's own menus (e.g. British English spellings).
    if [[ -n "$loc" ]]; then
        lang=${loc%%.*}
        printf '[Translations]\nLANGUAGE=%s:%s\n' "$lang" "${lang%%_*}" > "$home/.config/plasma-localerc.lang"
    fi
    # 12- or 24-hour clock. Only English needs a nudge; other languages keep their own convention.
    if [[ "$loc" == en_* ]]; then
        if [[ "$(j .clock)" == "12" ]]; then lct=en_US.UTF-8; else lct=en_GB.UTF-8; fi
        printf '[Formats]\nLANG=%s\nLC_TIME=%s\n' "$loc" "$lct" > "$home/.config/plasma-localerc"
    elif [[ -n "$loc" ]]; then
        printf '[Formats]\nLANG=%s\n' "$loc" > "$home/.config/plasma-localerc"
    fi
    [[ -f "$home/.config/plasma-localerc.lang" ]] && { echo >> "$home/.config/plasma-localerc"; cat "$home/.config/plasma-localerc.lang" >> "$home/.config/plasma-localerc"; rm -f "$home/.config/plasma-localerc.lang"; }
    chown -R "$user:$user" "$home/.config"
    restorecon -RF "$home" 2>/dev/null || true
fi

# The installer already created the account, so skip KDE's own first-run wizard.
touch /etc/plasma-setup-done

# Automated tests: report the desktop state once someone has signed in.
if [[ "$TEST" == "true" ]]; then
    touch /var/lib/magic-os/test-mode
    systemctl start --no-block magic-test-report.service || true
fi

rm -f "$S"
say "MAGIC-FIRSTBOOT-OK"
