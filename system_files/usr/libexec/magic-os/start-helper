"""Data and actions for Magic's Start menu (org.magicos.start).

    start-helper data          JSON: accent, user, waiting update, apps, tiles
    start-helper launch PATH   start an app (a .desktop file), remember it for "most used"
    start-helper run TASK      everyday tasks: internet, email, documents, ...
"""
import configparser
import glob
import json
import os
import pwd
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
USAGE = os.path.join(HOME, ".local/share/magic-os/start-usage.json")
CACHE = os.path.join(HOME, ".cache/magic-os/start-icons")
ACCENTS = "/usr/share/magic-os/accents.json"
ICON_PATHS = {   # line icons from the mockups (24x24)
    "internet": "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18",
    "files": "M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z",
    "email": "M3 6h18v12H3zM3 7l9 6 9-6",
    "documents": "M6 3h8l4 4v14H6zM9 12h6M9 16h6",
    "spreadsheets": "M4 4h16v16H4zM4 10h16M4 15h16M10 4v16",
    "photos": "M3 5h18v14H3zM3 16l5-5 4 4 3-3 6 6M15.5 9h.01",
    "music": "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM10 8.5v7l6-3.5z",
    "store": "M5 8h14l-1 12H6zM9 8V6a3 3 0 0 1 6 0v2",
    "settings": "M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M14 4v4M8 10v4M16 16v4",
    "printers": "M6 9V3h12v6M6 17H4v-8h16v8h-2M7 14h10v7H7z",
    "goback": "M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5M12 7v5l3 2",
    "power": "M12 3v8M6.3 6.3a8 8 0 1 0 11.4 0",
    "search": "M10.5 4a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM15.5 15.5L21 21",
    "user": "M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM4 21c0-4.4 3.6-7 8-7s8 2.6 8 7",
}
# task -> desktop ids to try, in order (first installed wins)
TASKS = [
    ("internet", "internet", ["com.vivaldi.Vivaldi", "org.mozilla.firefox", "firefox"]),
    ("email", "email", ["org.mozilla.Thunderbird", "org.gnome.Evolution", "org.kde.kmail2"]),
    ("documents", "documents", ["org.libreoffice.LibreOffice.writer", "org.onlyoffice.desktopeditors", "org.libreoffice.LibreOffice"]),
    ("spreadsheets", "spreadsheets", ["org.libreoffice.LibreOffice.calc", "org.onlyoffice.desktopeditors", "org.libreoffice.LibreOffice"]),
    ("photos", "photos", ["org.kde.gwenview"]),
    ("music", "music & video", ["org.videolan.VLC", "org.kde.haruna", "org.kde.elisa"]),
    ("files", "files", ["org.kde.dolphin"]),
    ("store", "app store", ["org.kde.discover"]),
]
HELP = [
    ("settings", "settings", "magic-settings"),
    ("printers", "printers", "magic-settings printers"),
    ("goback", "go back", "magic-settings updates"),
]


def data_dirs():
    dirs = [os.path.join(HOME, ".local/share")]
    dirs += (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
    for extra in ("/var/lib/flatpak/exports/share", os.path.join(HOME, ".local/share/flatpak/exports/share")):
        if extra not in dirs:
            dirs.append(extra)
    return dirs


def desktop_files():
    seen = {}
    for d in data_dirs():
        for path in sorted(glob.glob(os.path.join(d, "applications", "**", "*.desktop"), recursive=True)):
            did = os.path.relpath(path, os.path.join(d, "applications")).replace("/", "-")[:-8]
            if did not in seen:
                seen[did] = path
    return seen


def read_entry(path):
    cp = configparser.RawConfigParser(interpolation=None, strict=False)
    cp.optionxform = str
    try:
        cp.read(path, encoding="utf-8")
        return dict(cp["Desktop Entry"])
    except Exception:
        return None


def localized(e, key):
    lang = (os.environ.get("LANG") or "").split(".")[0]
    for k in (f"{key}[{lang}]", f"{key}[{lang.split('_')[0]}]", key):
        if e.get(k):
            return e[k]
    return ""


def visible(e):
    if not e or e.get("Type") != "Application":
        return False
    if e.get("NoDisplay") == "true" or e.get("Hidden") == "true":
        return False
    desk = set((os.environ.get("XDG_CURRENT_DESKTOP") or "KDE").split(":"))
    only = [x for x in e.get("OnlyShowIn", "").split(";") if x]
    if only and not desk & set(only):
        return False
    if desk & set(x for x in e.get("NotShowIn", "").split(";") if x):
        return False
    return True


def accent():
    try:
        acc = json.load(open(ACCENTS))
    except Exception:
        acc = {"default": "lime", "accents": {"lime": {"fill": "#4d7c0f", "text": "#bef264"}}}
    key = acc["default"]
    try:
        out = subprocess.run(["kreadconfig6", "--file", "kdeglobals", "--group", "General", "--key", "MagicAccent"],
                             capture_output=True, text=True, timeout=5).stdout.strip()
        if out in acc["accents"]:
            key = out
    except Exception:
        pass
    a = acc["accents"][key]
    return key, a["fill"], a["text"]


def icon_file(name, colour):
    os.makedirs(CACHE, exist_ok=True)
    f = os.path.join(CACHE, f"{name}-{colour.lstrip('#')}.svg")
    if not os.path.exists(f):
        with open(f, "w") as fh:
            fh.write(f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="48" height="48" fill="none" '
                     f'stroke="{colour}" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">'
                     f'<path d="{ICON_PATHS[name]}"/></svg>')
    return "file://" + f


def usage():
    try:
        return json.load(open(USAGE))
    except Exception:
        return {}


def waiting_update():
    try:
        out = subprocess.run(["/usr/libexec/magic-os/versions"], capture_output=True, text=True, timeout=20).stdout
        return json.loads(out).get("waiting") or ""
    except Exception:
        return ""


def cmd_data():
    files = desktop_files()
    apps = []
    for did, path in files.items():
        e = read_entry(path)
        if not visible(e):
            continue
        name = localized(e, "Name")
        if not name:
            continue
        apps.append({"id": did, "path": path, "name": name, "icon": e.get("Icon", "application-x-executable"),
                     "words": " ".join([localized(e, "GenericName"), localized(e, "Comment"), localized(e, "Keywords").replace(";", " ")]).lower()})
    apps.sort(key=lambda a: a["name"].lower())
    use = usage()
    by_id = {a["id"]: a for a in apps}
    most = [by_id[i] for i, _ in sorted(use.items(), key=lambda kv: -kv[1]) if i in by_id][:6]
    key, fill, text = accent()
    tiles = []
    for tkey, label, ids in TASKS:
        for i in ids:
            if i in files:
                tiles.append({"key": tkey, "label": label, "path": files[i], "icon": icon_file(tkey, text)})
                break
    help_tiles = [{"key": k, "label": l, "cmd": c, "icon": icon_file(k, text)} for k, l, c in HELP]
    u = pwd.getpwuid(os.getuid())
    full = (u.pw_gecos.split(",")[0] or u.pw_name)
    print(json.dumps({
        "accent": {"key": key, "fill": fill, "text": text},
        "user": {"name": full, "initial": full[:1].upper()},
        "waiting": waiting_update(),
        "apps": apps, "most": most, "tiles": tiles, "help": help_tiles,
        "icons": {k: icon_file(k, text) for k in ("power", "search", "settings", "user")},
        "iconsMuted": {k: icon_file(k, "#cfc9c5") for k in ("power", "settings", "files")},
    }))


def remember(path):
    did = None
    for d in data_dirs():
        base = os.path.join(d, "applications") + os.sep
        if path.startswith(base):
            did = path[len(base):].replace("/", "-")[:-8]
    if not did:
        return
    use = usage()
    use[did] = use.get(did, 0) + 1
    os.makedirs(os.path.dirname(USAGE), exist_ok=True)
    json.dump(use, open(USAGE, "w"))


def cmd_launch(path):
    if not path.endswith(".desktop") or not os.path.isfile(path):
        sys.exit(1)
    subprocess.Popen(["kioclient", "exec", path], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        remember(path)
    except Exception:
        pass


def cmd_run(task):
    for k, _, c in HELP + [("you", "", "magic-settings you")]:
        if k == task:
            subprocess.Popen(c.split(), start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
    sys.exit(1)


if __name__ == "__main__":
    if len(sys.argv) >= 2 and sys.argv[1] == "data":
        cmd_data()
    elif len(sys.argv) == 3 and sys.argv[1] == "launch":
        cmd_launch(sys.argv[2])
    elif len(sys.argv) == 3 and sys.argv[1] == "run" and re.match(r"^[a-z]+$", sys.argv[2]):
        cmd_run(sys.argv[2])
    else:
        print(__doc__)
        sys.exit(2)
